<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:background="@color/blush_deep" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingTop="14dp"
        android:paddingEnd="10dp"
        android:paddingBottom="14dp">

        <!-- Only shown when the user added a photo -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/user_equipment_photo"
            android:layout_width="@dimen/ski_resort_img"
            android:layout_height="@dimen/ski_resort_img"
            android:layout_marginEnd="14dp"
            android:background="@color/white"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:visibility="gone"
            app:shapeAppearanceOverlay="@style/RoundedImageStyle"
            tools:src="@drawable/boots_pic_equipment"
            tools:visibility="visible" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/user_equipment_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/merriweathersans_semibold"
                android:textColor="@color/history_body_text"
                android:textSize="@dimen/equip_brand_name"
                tools:text="Burton Photon Boa" />

            <TextView
                android:id="@+id/user_equipment_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingMultiplier="1.25"
                android:textColor="@color/history_body_text"
                android:textSize="@dimen/tip_card_body"
                tools:text="Stiff, responsive and warm. Great for all-mountain riding." />
        </LinearLayout>

        <!-- Only on equipment the signed-in user added -->
        <LinearLayout
            android:id="@+id/owner_actions"
            style="@style/OwnerActions"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/btn_edit"
                style="@style/OwnerEditButton" />

            <ImageView
                android:id="@+id/btn_delete"
                style="@style/OwnerDeleteButton"
                android:layout_marginTop="10dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
