<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/wine_maroon"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:strokeColor="#E6FFFFFF"
        app:strokeWidth="1.5dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Mountain photo behind the whole dialog, loaded with Glide so it is downsampled.
                 Pinned to the form's bounds so the form alone decides the dialog's height -->
            <ImageView
                android:id="@+id/img_background"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                app:layout_constraintBottom_toBottomOf="@id/form_scroll"
                app:layout_constraintEnd_toEndOf="@id/form_scroll"
                app:layout_constraintStart_toStartOf="@id/form_scroll"
                app:layout_constraintTop_toTopOf="@id/form_scroll" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@drawable/bg_add_dialog_scrim"
                app:layout_constraintBottom_toBottomOf="@id/form_scroll"
                app:layout_constraintEnd_toEndOf="@id/form_scroll"
                app:layout_constraintStart_toStartOf="@id/form_scroll"
                app:layout_constraintTop_toTopOf="@id/form_scroll" />

            <androidx.core.widget.NestedScrollView
                android:id="@+id/form_scroll"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constrainedHeight="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="20dp"
                    android:paddingTop="20dp"
                    android:paddingBottom="24dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <!-- Title painted on a brush stroke -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="40dp"
                            android:background="@drawable/bg_brush_stroke"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="26dp"
                            android:paddingTop="14dp"
                            android:paddingEnd="38dp"
                            android:paddingBottom="14dp"
                            android:rotation="-3">

                            <ImageView
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_mountain"
                                app:tint="@color/white" />

                            <TextView
                                android:id="@+id/txt_dialog_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:fontFamily="@font/permanentmarker_regular"
                                android:maxLines="1"
                                android:textAllCaps="true"
                                android:textColor="@color/white"
                                android:textSize="26sp"
                                tools:text="Add video" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/img_close"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_gravity="top|end"
                            android:clickable="true"
                            android:contentDescription="@null"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackgroundBorderless"
                            android:padding="2dp"
                            android:src="@drawable/ic_close"
                            app:tint="@color/white" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="6dp"
                        android:fontFamily="@font/merriweathersans_semibold"
                        android:lineSpacingMultiplier="1.15"
                        android:shadowColor="#99000000"
                        android:shadowDy="1"
                        android:shadowRadius="4"
                        android:text="@string/add_content_subtitle"
                        android:textColor="@color/white"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:id="@+id/field_title"
                        style="@style/AddContentField">

                        <ImageView
                            android:id="@+id/img_title_icon"
                            style="@style/AddContentFieldIcon"
                            tools:src="@drawable/ic_videocam" />

                        <View style="@style/AddContentFieldDivider" />

                        <EditText
                            android:id="@+id/edit_title"
                            style="@style/AddContentInput"
                            android:inputType="textCapSentences"
                            android:maxLength="80"
                            android:singleLine="true" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/field_link"
                        style="@style/AddContentField">

                        <ImageView
                            style="@style/AddContentFieldIcon"
                            android:src="@drawable/ic_link" />

                        <View style="@style/AddContentFieldDivider" />

                        <EditText
                            android:id="@+id/edit_link"
                            style="@style/AddContentInput"
                            android:inputType="textUri"
                            android:singleLine="true" />
                    </LinearLayout>

                    <!-- Multi-line: icon and divider stay at the top of the box -->
                    <LinearLayout
                        android:id="@+id/field_description"
                        style="@style/AddContentField"
                        android:gravity="top">

                        <ImageView
                            style="@style/AddContentFieldIcon"
                            android:layout_marginTop="16dp"
                            android:src="@drawable/ic_description" />

                        <View
                            style="@style/AddContentFieldDivider"
                            android:layout_marginTop="13dp" />

                        <EditText
                            android:id="@+id/edit_description"
                            style="@style/AddContentInput"
                            android:gravity="top|start"
                            android:inputType="textCapSentences|textMultiLine"
                            android:maxLength="2000"
                            android:minLines="4" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/field_quote"
                        style="@style/AddContentField">

                        <ImageView
                            style="@style/AddContentFieldIcon"
                            android:src="@drawable/ic_quote" />

                        <View style="@style/AddContentFieldDivider" />

                        <EditText
                            android:id="@+id/edit_quote"
                            style="@style/AddContentInput"
                            android:hint="@string/hint_quote_optional"
                            android:inputType="textCapSentences"
                            android:maxLength="120"
                            android:singleLine="true" />
                    </LinearLayout>

                    <!-- Optional photo for equipment and ski slopes; tap to pick one from the gallery -->
                    <FrameLayout
                        android:id="@+id/photo_box"
                        android:layout_width="match_parent"
                        android:layout_height="150dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_glass_field"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground">

                        <LinearLayout
                            android:id="@+id/photo_placeholder"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:background="@drawable/bg_glass_circle"
                                android:contentDescription="@null"
                                android:padding="10dp"
                                android:src="@drawable/ic_camera"
                                app:tint="@color/white" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:fontFamily="@font/merriweathersans_regular"
                                android:text="@string/add_photo_optional"
                                android:textColor="#D9E8EEF4"
                                android:textSize="@dimen/login_input_text" />
                        </LinearLayout>

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/img_photo"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@null"
                            android:scaleType="centerCrop"
                            android:visibility="gone"
                            app:shapeAppearanceOverlay="@style/RoundedImageStyle" />

                        <ImageView
                            android:id="@+id/btn_remove_photo"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_gravity="top|end"
                            android:layout_margin="8dp"
                            android:background="@drawable/bg_camera_badge"
                            android:contentDescription="@string/remove_photo"
                            android:padding="6dp"
                            android:src="@drawable/ic_close"
                            android:visibility="gone"
                            app:tint="@color/wine_maroon" />
                    </FrameLayout>

                    <LinearLayout
                        android:id="@+id/btn_save"
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:layout_marginTop="22dp"
                        android:background="@drawable/bg_add_button"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/img_save_icon"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_add_circle"
                            app:tint="@color/white" />

                        <TextView
                            android:id="@+id/txt_save"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:fontFamily="@font/merriweathersans_bold"
                            android:textColor="@color/white"
                            android:textSize="@dimen/login_button_text"
                            tools:text="@string/btn_add" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
</layout>
