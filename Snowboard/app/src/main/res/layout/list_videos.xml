<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/history_card_gap"
    app:cardBackgroundColor="@color/history_card"
    app:cardCornerRadius="@dimen/history_card_corner"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp">

        <!-- Rounded frame clips the player to the card's corners -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/video_frame"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/wine_maroon"
            app:cardCornerRadius="@dimen/video_frame_corner"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <com.pierfrancescosoffritti.androidyoutubeplayer.core.player.views.YouTubePlayerView
                android:id="@+id/webVideos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                app:enableAutomaticInitialization="false" />
        </com.google.android.material.card.MaterialCardView>

        <FrameLayout
            android:id="@+id/video_badge"
            android:layout_width="@dimen/video_badge"
            android:layout_height="@dimen/video_badge"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_video_badge"
            app:layout_constraintBottom_toBottomOf="@id/descriptionVideos"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/titleVideos">

            <ImageView
                android:layout_width="@dimen/video_badge_icon"
                android:layout_height="@dimen/video_badge_icon"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_ondemand_video"
                app:tint="@color/white" />
        </FrameLayout>

        <View
            android:id="@+id/video_divider"
            android:layout_width="1.5dp"
            android:layout_height="0dp"
            android:layout_marginStart="14dp"
            android:background="@color/history_divider"
            app:layout_constraintBottom_toBottomOf="@id/descriptionVideos"
            app:layout_constraintStart_toEndOf="@id/video_badge"
            app:layout_constraintTop_toTopOf="@id/titleVideos" />

        <TextView
            android:id="@+id/titleVideos"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:fontFamily="@font/merriweathersans_bold"
            android:maxLines="2"
            android:textColor="@color/wine_maroon"
            android:textSize="@dimen/tip_card_title"
            app:layout_constraintEnd_toStartOf="@id/owner_actions"
            app:layout_constraintStart_toEndOf="@id/video_divider"
            app:layout_constraintTop_toBottomOf="@id/video_frame"
            tools:text="Why Riding Duck Foot Is Holding You Back" />

        <!-- Only shown on videos the signed-in user added -->
        <LinearLayout
            android:id="@+id/owner_actions"
            style="@style/OwnerActions"
            android:layout_marginEnd="4dp"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/titleVideos">

            <ImageView
                android:id="@+id/btn_edit"
                style="@style/OwnerEditButton" />

            <ImageView
                android:id="@+id/btn_delete"
                style="@style/OwnerDeleteButton"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/descriptionVideos"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:lineSpacingMultiplier="1.25"
            android:textColor="@color/history_body_text"
            android:textSize="@dimen/tip_card_body"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@id/titleVideos"
            app:layout_constraintStart_toStartOf="@id/titleVideos"
            app:layout_constraintTop_toBottomOf="@id/titleVideos"
            tools:text="Shows why angle of the duck foot is important" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
