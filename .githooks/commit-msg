#!/bin/sh
# Validates the commit message subject line (SNOW-69).
# Required format: SNOW-<number> <Description>, e.g. "SNOW-4 Ski Slopes Redesign"
# The same rules are checked in CI (.github/workflows/android-ci.yml).

# First line that isn't a comment or blank; strip Windows line endings
subject=$(tr -d '\r' < "$1" | grep -v '^#' | sed '/^[[:space:]]*$/d' | head -n1)

# Messages generated by git itself are allowed as-is
if echo "$subject" | grep -qE '^(Merge|Revert|fixup!|squash!|amend!) '; then
  exit 0
fi

if ! echo "$subject" | grep -qE '^SNOW-[0-9]+ [A-Z].{4,}$'; then
  echo "✖ Invalid commit message: \"$subject\""
  echo "  Required format: SNOW-<number> <Description starting with a capital letter>"
  echo "  Example:         SNOW-4 Ski Slopes Redesign"
  exit 1
fi

if [ ${#subject} -gt 72 ]; then
  echo "✖ Commit subject is ${#subject} characters, the limit is 72:"
  echo "  \"$subject\""
  exit 1
fi

exit 0
